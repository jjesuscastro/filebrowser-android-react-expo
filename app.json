{
  "expo": {
    "name": "File Browser Native",
    "slug": "file-browser-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/file-browser-wrapper-icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.hesukastro.filebrowser",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#071f3a",
        "foregroundImage": "./assets/file-browser-wrapper-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/file-browser-wrapper-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#071f3a"
        }
      ],
      "./plugins/withAndroidCleartext",
      "expo-secure-store",
      "expo-sharing",
      "expo-video",
      "expo-audio",
      "expo-asset",
      "expo-font"
    ]
  }
}
